{
  "schemaVersion": 2,
  "selectionPrefix": "stellaris:latest-stable/",
  "refreshSeconds": 3600,
  "openai": {
    "baseUrl": "https://api.openai.com/v1",
    "defaultModel": "gpt-6.1-terra",
    "fallbackModels": ["gpt-5.6-terra", "gpt-6-luna", "gpt-5.6-luna", "gpt-6.1-sol", "gpt-5.6-sol"],
    "lowerUsageModels": ["gpt-6-luna", "gpt-5.6-luna"],
    "reasoningEffort": {
      "gpt-6-astra": { "advisor": "medium", "chronicle": "medium" },
      "gpt-6.1-sol": { "advisor": "low", "chronicle": "medium" },
      "gpt-6.1-terra": { "advisor": "low", "chronicle": "medium" },
      "gpt-6-luna": { "advisor": "none", "chronicle": "none" },
      "gpt-5.6-sol": { "advisor": "low", "chronicle": "medium" },
      "gpt-5.6-terra": { "advisor": "low", "chronicle": "medium" },
      "gpt-5.6-luna": { "advisor": "low", "chronicle": "medium" }
    },
    "reasoningSource": "https://developers.openai.com/api/docs/guides/latest-model"
  },
  "openrouterRecommendations": ["gemini-flash-lite", "deepseek-flash", "claude-sonnet"],
  "families": {
    "gemini-flash-lite": {
      "name": "Gemini Flash-Lite",
      "patterns": {
        "gemini": "^gemini-([0-9]+(?:\\.[0-9]+)*)-flash-lite$",
        "openrouter": "^google/gemini-([0-9]+(?:\\.[0-9]+)*)-flash-lite$"
      },
      "source": "https://ai.google.dev/gemini-api/docs/models#model-versions"
    },
    "gemini-flash": {
      "name": "Gemini Flash",
      "patterns": {
        "gemini": "^gemini-([0-9]+(?:\\.[0-9]+)*)-flash$",
        "openrouter": "^google/gemini-([0-9]+(?:\\.[0-9]+)*)-flash$"
      },
      "source": "https://ai.google.dev/gemini-api/docs/models#model-versions"
    },
    "deepseek-flash": {
      "name": "DeepSeek Flash",
      "patterns": {
        "openrouter": "^deepseek/deepseek-v([0-9]+(?:\\.[0-9]+)*)-flash(?:-([0-9]{4,8}))?$"
      },
      "source": "https://openrouter.ai/api/v1/models"
    },
    "claude-sonnet": {
      "name": "Claude Sonnet",
      "patterns": {
        "openrouter": "^anthropic/claude-sonnet-([0-9]+(?:\\.[0-9]+)*)(?:-([0-9]{8}))?$"
      },
      "source": "https://openrouter.ai/api/v1/models"
    }
  }
}
